{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oroya Video",
  "version": "0.1.0",
  "identifier": "dev.oroya.video",
  "build": {
    "beforeDevCommand": "pnpm start",
    "devUrl": "http://localhost:4200",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist/frontend/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Oroya Video",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "resources/backend": "backend"
    }
  }
}
