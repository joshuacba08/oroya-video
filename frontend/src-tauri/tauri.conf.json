{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oroya Video",
  "version": "0.3.0",
  "identifier": "dev.oroya.video",
  "build": {
    "beforeDevCommand": "pnpm start",
    "devUrl": "http://localhost:4200",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist/frontend/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Oroya Video",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: http://127.0.0.1:*",
        "media-src": "'self' blob: http://127.0.0.1:*",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:*",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "resources/backend": "backend"
    },
    "publisher": "Oroya Video",
    "shortDescription": "Mejora de video local con IA",
    "category": "Video",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgxMzcwOEVEMTIzMzMxOEEKUldTS01UTVM3UWczZ1IyYm9QdEl3Y3hNU05ucG9YREZzbXVHNHE2a1ZjZGVxam1MdGU2TFdOUlUK",
      "endpoints": [
        "https://github.com/joshuacba08/oroya-video/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
