APP_NAME=Oroya Video Backend
APP_VERSION=0.1.0
API_VERSION=v1
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8001
DEBUG=true
STORAGE_PATH=storage
DATABASE_URL=sqlite:///storage/db/oroya-video.sqlite
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,tauri://localhost,http://tauri.localhost,https://tauri.localhost
# Set to "realesrgan" once torch + CUDA and the model weights are installed
# (see backend/README.md, "Enabling Real-ESRGAN").
FRAME_ENHANCER_ENGINE=mock
AI_DEVICE=auto
AI_ALLOW_CPU=true
AI_HALF_PRECISION=true
REALESRGAN_TILE_SIZE=0
REALESRGAN_TILE_PAD=10
REALESRGAN_PRE_PAD=0
REALESRGAN_MAX_FAILED_FRAMES=0
REALESRGAN_CLEAR_CUDA_CACHE=true
JOB_RECOVERY_ENABLED=true
MARK_RUNNING_JOBS_INTERRUPTED_ON_STARTUP=true
CLEANUP_TEMP_ON_SUCCESS=true
CLEANUP_KEEP_PREVIEW_FRAMES=24
CLEANUP_TEMP_OLDER_THAN_HOURS=72
MAX_JOB_RETRIES=3
PROCESS_SHUTDOWN_TIMEOUT_SECONDS=5
PREFLIGHT_MIN_FREE_DISK_GB=10
AUDIT_LOG_ENABLED=true
